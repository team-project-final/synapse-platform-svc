<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <Match>
        <Class name="~com\.synapse\.platform\.(UserRegistered|NotificationSend)(\$.*)?"/>
    </Match>
    <Match>
        <Class name="~com\.synapse\.platform\.auth\.config\.(OAuth2AuthorizationRequestDto|HttpCookieOAuth2AuthorizationRequestRepository|SecurityConfig)"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="~com\.synapse\.platform\.auth\.(controller\.(AuthController|MfaController|TenantSelfServiceController)|config\.JwtAuthenticationFilter|service\.(RefreshTokenService|OAuth2SuccessHandler|EmailPasswordAuthService|TenantSelfServiceService))"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="~com\.synapse\.platform\.(auth\.service\.UserSessionRevocationListener|user\.controller\.AdminUserController|billing\.(controller\.AdminTenantController|service\.AdminTenantService)|auth\.service\.TenantAdminService)"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.synapse.platform.billing.service.BillingService"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="~com\.synapse\.platform\.audit\.(controller\.AuditLogController|consumer\.AuditKafkaConsumer|service\.AuditLogService)"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="~com\.synapse\.platform\.(auth\.(event\.(UserEventPublisher|OutboxEventPublisher)|service\.KafkaPasswordResetCodeSender)|global\.kafka\.KafkaErrorHandlerConfig)"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="~com\.synapse\.platform\.notification\.service\.(SesEmailService|FcmPushService)"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- 벤더링한 생성 Avro 클래스(타 서비스 이벤트 계약). 해당 네임스페이스엔 수기 코드 없음 —
         SpotBugs 전체 제외. 기존 platform Avro(UserRegistered/NotificationSend)와 동일 취지. -->
    <Match>
        <Class name="~com\.synapse\.(knowledge|engagement|learning)\..*"/>
    </Match>
</FindBugsFilter>
